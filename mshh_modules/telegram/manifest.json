{
  "id": "telegram",
  "name": "Telegram",
  "version": "1.0.0",
  "runtime": "main",
  "auth": "custom",
  "fields": [
    {
      "name": "phone",
      "label": "Телефон",
      "type": "text",
      "placeholder": "+79990001122",
      "help": "Только для входа по коду; QR-вход работает без телефона"
    },
    {
      "name": "apiId",
      "label": "API ID",
      "type": "number",
      "help": "api_id с my.telegram.org; можно оставить по умолчанию"
    },
    {
      "name": "apiHash",
      "label": "API Hash",
      "type": "text",
      "help": "api_id с my.telegram.org; можно оставить по умолчанию"
    },
    {
      "name": "proxyHost",
      "label": "Прокси: адрес",
      "type": "text",
      "placeholder": "необязательно",
      "help": "SOCKS5-прокси для соединения (если нужно)"
    },
    {
      "name": "proxyPort",
      "label": "Прокси: порт",
      "type": "number",
      "placeholder": "необязательно"
    },
    {
      "name": "proxyUser",
      "label": "Прокси: логин",
      "type": "text",
      "placeholder": "необязательно"
    },
    {
      "name": "proxyPassword",
      "label": "Прокси: пароль",
      "type": "password",
      "placeholder": "необязательно"
    }
  ],
  "capabilities": { "media": true, "history": true, "typing": true, "create": true, "peerProfile": true }
}
